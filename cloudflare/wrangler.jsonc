{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "builtbyaadi-canvas-beta",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "canvas.builtbyaadi.com", "custom_domain": true}],
  "vars": {
    "HOSTED_ENABLED": "false",
    "MAIL_ENABLED": "false",
    "MAIL_FROM": "accounts@builtbyaadi.com"
  },
  "containers": [{
    "class_name": "CanvasContainer",
    "image": "../Dockerfile",
    "image_build_context": "..",
    "max_instances": 1,
    "instance_type": "basic"
  }],
  "durable_objects": {"bindings": [
    {"name": "CANVAS_CONTAINER", "class_name": "CanvasContainer"},
    {"name": "CANVAS_STORE", "class_name": "CanvasStore"}
  ]},
  "exports": {
    "CanvasContainer": {"type": "durable-object", "storage": "sqlite"},
    "CanvasStore": {"type": "durable-object", "storage": "sqlite"}
  },
  "send_email": [{
    "name": "EMAIL",
    "allowed_sender_addresses": ["accounts@builtbyaadi.com"]
  }],
  "observability": {"enabled": false}
}
