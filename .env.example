# Personal local stdio only. Keep real values outside the repository.
CANVAS_BASE_URL=https://school.instructure.com
CANVAS_API_TOKEN=replace-with-your-personal-token

# Institution-hosted mode. Never share one user's Canvas token across accounts.
CONNECTOR_AUTH_MODE=institution
CONNECTOR_PUBLIC_URL=https://canvas.example.org
CONNECTOR_DATABASE=/data/connector.sqlite3
# For separate hosts/replicas, install .[postgres] and use a private PostgreSQL DSN instead.
# CONNECTOR_DATABASE=postgresql://USER:PASSWORD@DATABASE-HOST/connector?sslmode=require
CONNECTOR_ENCRYPTION_KEY=generate-with-canvas-connector-keygen
CONNECTOR_INSTITUTIONS_FILE=/run/secrets/institutions.json

# Experimental Built by Aadi accounts: Cloudflare Container + durable store only.
# This alternative does not need CONNECTOR_INSTITUTIONS_FILE.
# CONNECTOR_AUTH_MODE=builtbyaadi
# CONNECTOR_DATABASE=cloudflare://store
# CONNECTOR_ACCOUNT_MAIL=cloudflare
# Leave mail disabled until the private Cloudflare email binding/sender is ready.
# Canvas policy does not permit multi-user apps collecting manual tokens;
# this beta implementation is not evidence of permission to launch that flow.

# Personal hosted server: one operator-provisioned owner, no public signup/mail.
# CONNECTOR_AUTH_MODE=personal
# CONNECTOR_DATABASE=/data/personal.sqlite3
# Provision through `canvas-connector owner-init` in a private terminal first.
# Use one worker so all assistant grants share the upstream concurrency gate.

# Optional: exact trusted reverse-proxy peers, never a wildcard.
# CONNECTOR_TRUSTED_PROXIES=127.0.0.1,::1
