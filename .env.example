# Personal local stdio only. Keep real values outside the repository.
CANVAS_BASE_URL=https://school.instructure.com
CANVAS_API_TOKEN=replace-with-your-personal-token

# Hosted mode: Canvas OAuth, never a shared personal token.
CONNECTOR_PUBLIC_URL=https://canvas.example.org
CONNECTOR_DATABASE=/data/connector.sqlite3
CONNECTOR_ENCRYPTION_KEY=generate-with-canvas-connector-keygen
CONNECTOR_INSTITUTIONS_FILE=/run/secrets/institutions.json
