# Reference Linux host only. Copy outside the repository and restrict permissions.
# Deployment is pending a host and institution OAuth credentials.
CONNECTOR_PUBLIC_URL=https://canvas.builtbyaadi.com
CONNECTOR_DATABASE=/var/lib/canvas-connector/connector.sqlite3
# Generate once with canvas-connector keygen; keep private and backed up.
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_INSTITUTIONS_FILE=/etc/canvas-connector/institutions.json
# Valid only for the same-host, loopback Caddy reference configuration.
CONNECTOR_TRUSTED_PROXIES=127.0.0.1,::1
